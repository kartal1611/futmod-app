{
  "expo": {
    "name": "TorunFC",
    "slug": "torunfc-app",
    "owner": "kartall",
    "privacy": "unlisted",
    "version": "1.1.1",
    "orientation": "portrait",
    "scheme": "torunfc",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1f15"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.torunfc.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1f15"
      },
      "package": "com.torunfc.app",
      "versionCode": 1,
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a1f15",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eeb6cf16-0850-4b14-9e2f-919a8c01831f"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eeb6cf16-0850-4b14-9e2f-919a8c01831f"
    }
  }
}
